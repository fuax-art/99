<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FUAX - Forever Unfinished Artworx</title>
    <style>
        body { font-family: 'Arial', sans-serif; margin: 0; padding: 0; background: #000; color: #fff; }
        .hero { background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('your-fox-mural.jpg'); background-size: cover; height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; }
        .hero h1 { font-size: 4em; text-shadow: 2px 2px 4px #ff00ff; }
        .hero p { font-size: 1.5em; }
        .gallery { padding: 50px; display: flex; flex-wrap: wrap; justify-content: center; }
        .item { margin: 20px; text-align: center; }
        .item img { width: 200px; height: 200px; object-fit: cover; border: 2px solid #ff00ff; }
        .buy-btn { background: #ff00ff; color: #000; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; }
        .buy-btn:hover { background: #fff; }
        footer { text-align: center; padding: 20px; background: #111; }
    </style>
</head>
<body>
    <section class="hero">
        <div>
            <h1>FUAX</h1>
            <p>Forever Unfinished Artworx – No Faux Pause. Art from the Edge.</p>
        </div>
    </section>
    <section class="gallery">
        <div class="item">
            <img src="placeholder-tee.jpg" alt="No Fox Paws Tee">
            <h3>No Fox Paws Tee</h3>
            <a href="https://printful.com/your-link-here" class="buy-btn" target="_blank">Buy Now ($25)</a>
        </div>
        <div class="item">
            <img src="placeholder-print.jpg" alt="Foxfire Poster">
            <h3>Foxfire Poster</h3>
            <a href="https://printful.com/your-link-here" class="buy-btn" target="_blank">Buy Now ($35)</a>
        </div>
        <!-- Add 3 more items similarly -->
    </section>
    <footer>
        <p>© 2025 FUAX| Unleash the Fox | <a href="mailto:fireverunfinishedartworx@gmail.com">Collab?</a></p>
    </footer>
    <script>
        // Simple click tracker – console.log for now; swap to Google Analytics later
        document.querySelectorAll('.buy-btn').forEach(btn => {
            btn.addEventListener('click', () => console.log('Buy clicked: ' + btn.textContent));
        });
    </script>
</body>
</html>
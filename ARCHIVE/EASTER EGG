  <!-- EASTER EGG MODAL: Hidden YouTube video and NFT claim, revealed by clicking the image above -->
<div id="about-egg-modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.85); align-items:center; justify-content:center;">
  <div style="background:#222; border-radius:16px; max-width:95vw; width:600px; margin:auto; padding:2em 1em; box-shadow:0 8px 32px #000a; position:relative; display:flex; flex-direction:column; align-items:center;">
    <button id="egg-modal-close" style="position:absolute; top:1em; right:1em; background:none; border:none; color:#fff; font-size:2em; cursor:pointer;">&times;</button>
    <div id="egg-animation" style="margin-bottom:1em;"></div>
    <iframe width="100%" height="315" src="https://youtube.com/shorts/58t27Kg2u10?feature=share"
      title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen style="border-radius:12px;"></iframe>
    <div style="margin-top:2em; width:100%; text-align:center;">
      <h3>Claim a Free NFT!</h3>
      <button id="connect-wallet" style="padding:0.5em 1em; margin-bottom:1em;">Connect Wallet</button>
      <form id="nft-claim-form" style="display:none; flex-direction:column; align-items:center;">
        <label for="polygon-wallet" style="font-weight:bold;">Polygon Wallet Address:</label><br>
        <input type="text" id="polygon-wallet" name="polygon-wallet" placeholder="0x..." style="width:320px;max-width:90%;padding:0.5em;margin:0.5em 0;" required>
        <button type="submit" style="padding:0.5em 1em;">Claim NFT</button>
      </form>
      <div id="nft-claim-message" style="margin-top:1em;color:#4caf50;font-weight:bold;"></div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/web3@1.10.0/dist/web3.min.js"></script>
<script>
  // Easter Egg persistent count logic
  function updateEggCountDisplay() {
    var count = parseInt(localStorage.getItem('eggCount') || '0', 10);
    var display = document.getElementById('egg-count-display');
    if (display) {
      display.textContent = `🥚Found: ${count}`;
    }
  }
  document.addEventListener('DOMContentLoaded', function() {
    // Change selector to the new dot
    var aboutDot = document.getElementById('about-dot-easter-egg');
    var modal = document.getElementById('about-egg-modal');
    var closeBtn = document.getElementById('egg-modal-close');
    var eggAnimation = document.getElementById('egg-animation');
    var connectBtn = document.getElementById('connect-wallet');
    var nftForm = document.getElementById('nft-claim-form');
    var nftMsg = document.getElementById('nft-claim-message');
    var walletInput = document.getElementById('polygon-wallet');
    var animationPlayed = false;
    var userWallet = null;

    // Show modal and animation
    if (aboutDot && modal) {
      aboutDot.addEventListener('click', function() {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        if (!animationPlayed && eggAnimation) {
          eggAnimation.innerHTML = `<svg width='120' height='120' viewBox='0 0 120 120'><circle cx='60' cy='60' r='50' fill='#fffbe6' stroke='#ffb300' stroke-width='6'><animate attributeName='r' values='50;60;50' dur='1.2s' repeatCount='2'/></circle><text x='60' y='70' text-anchor='middle' font-size='32' fill='#ffb300' font-family='monospace' font-weight='bold' opacity='0'><animate attributeName='opacity' values='0;1;1;0' keyTimes='0;0.2;0.8;1' dur='1.2s' repeatCount='2'/><tspan>🥚</tspan></text></svg>`;
          setTimeout(function(){ eggAnimation.innerHTML = ''; }, 2400);
          animationPlayed = true;
        }
        // Increment persistent egg count
        var count = parseInt(localStorage.getItem('eggCount') || '0', 10) + 1;
        localStorage.setItem('eggCount', count);
        updateEggCountDisplay();
      });
    }
    // Close modal
    if (closeBtn && modal) {
      closeBtn.addEventListener('click', function() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      });
      // Also close when clicking outside the modal content
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          modal.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
    }
    // Wallet connect logic
    if (connectBtn && nftForm && walletInput) {
      connectBtn.addEventListener('click', async function() {
        if (window.ethereum) {
          try {
            const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
            userWallet = accounts[0];
            walletInput.value = userWallet;
            nftForm.style.display = 'flex';
            connectBtn.style.display = 'none';
            nftMsg.textContent = '';
          } catch (err) {
            nftMsg.textContent = 'Wallet connection rejected.';
            nftMsg.style.color = '#e53935';
          }
        } else {
          nftMsg.textContent = 'MetaMask or compatible wallet not found.';
          nftMsg.style.color = '#e53935';
        }
      });
    }
    // NFT claim form handler (real integration placeholder)
    if (nftForm && nftMsg) {
      nftForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        var address = walletInput.value.trim();
        if (/^0x[a-fA-F0-9]{40}$/.test(address)) {
          nftMsg.style.color = '#4caf50';
          nftMsg.textContent = 'Submitting to blockchain...';
          // TODO: Replace this with your real NFT mint/airdrop logic
          // Example: call a backend API or interact with a smart contract
          setTimeout(function() {
            nftMsg.textContent = 'Success! Your NFT will be airdropped soon.';
          }, 2000);
          nftForm.reset();
        } else {
          nftMsg.textContent = 'Please enter a valid Polygon wallet address.';
          nftMsg.style.color = '#e53935';
        }
      });
    }
    updateEggCountDisplay();
  });
</script>